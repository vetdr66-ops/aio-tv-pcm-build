+
+#define MPV_PCM_TAP_SLOT_COUNT 4u
+
+struct pcm_tap_slot {
+    mpv_pcm_tap_metadata metadata;
+    uint32_t generation;
+    uint8_t payload[MPV_PCM_TAP_MAX_PAYLOAD_BYTES];
+};
+
+static struct {
+    _Atomic uint32_t head;
+    _Atomic uint32_t tail;
+    _Atomic uint32_t dropped;
+    /* Bit 0 = enabled; upper 31 bits = PCM session generation. */
+    _Atomic uint32_t state;
+    _Atomic bool supported;
+    _Atomic int diagnostic_state;
+    struct pcm_tap_slot slots[MPV_PCM_TAP_SLOT_COUNT];
+} pcm_tap;
+
+static void pcm_tap_drop(void)
+{
+    atomic_fetch_add_explicit(&pcm_tap.dropped, 1u, memory_order_relaxed);
+}
+
+static void pcm_tap_initialize(void)
+{
+    atomic_init(&pcm_tap.state, 0u);
+    atomic_init(&pcm_tap.dropped, 0u);
+    atomic_init(&pcm_tap.supported, false);
+    atomic_init(&pcm_tap.diagnostic_state, 1);
+
+    bool lock_free = atomic_is_lock_free(&pcm_tap.head) &&
+                     atomic_is_lock_free(&pcm_tap.tail) &&
+                     atomic_is_lock_free(&pcm_tap.dropped) &&
+                     atomic_is_lock_free(&pcm_tap.state);
+
+    atomic_store_explicit(&pcm_tap.supported, lock_free, memory_order_release);
+    atomic_store_explicit(&pcm_tap.diagnostic_state,
+                          lock_free ? 2 : -1, memory_order_release);
+}
+
+int mpv_pcm_tap_set_enabled(int enabled)
+{
+    if (!atomic_load_explicit(&pcm_tap.supported, memory_order_acquire))
+        return 0;
+
+    uint32_t old_state = atomic_load_explicit(&pcm_tap.state, memory_order_acquire);
+    for (;;) {
+        bool was_enabled = (old_state & 1u) != 0;
+        if (!!enabled == was_enabled)
+            return 1;
+
+        uint32_t new_state;
+        if (enabled) {
+            uint32_t head = atomic_load_explicit(&pcm_tap.head, memory_order_acquire);
+            uint32_t tail = atomic_load_explicit(&pcm_tap.tail, memory_order_acquire);
+            if (head != tail)
+                return 0;
+            uint32_t generation = ((old_state >> 1) + 1u) & 0x7fffffffu;
+            new_state = (generation << 1) | 1u;
+        } else {
+            new_state = old_state & ~1u;
+        }
+
+        if (atomic_compare_exchange_weak_explicit(
+                &pcm_tap.state, &old_state, new_state,
+                memory_order_acq_rel, memory_order_acquire))
+            return 1;
+    }
+}
+
+int mpv_pcm_tap_read(mpv_pcm_tap_metadata *metadata, void *payload,
+                     size_t payload_capacity)
+{
+    if (!metadata || !payload)
+        return -1;
+
+    for (;;) {
+        uint32_t tail = atomic_load_explicit(&pcm_tap.tail, memory_order_relaxed);
+        uint32_t head = atomic_load_explicit(&pcm_tap.head, memory_order_acquire);
+        if (tail == head)
+            return 0;
+
+        const struct pcm_tap_slot *slot =
+            &pcm_tap.slots[tail & (MPV_PCM_TAP_SLOT_COUNT - 1u)];
+        uint32_t state = atomic_load_explicit(&pcm_tap.state, memory_order_acquire);
+        uint32_t generation = state >> 1;
+
+        if (slot->generation != generation) {
+            atomic_store_explicit(&pcm_tap.tail, tail + 1u, memory_order_release);
+            continue;
+        }
+        if (slot->metadata.payload_bytes > payload_capacity)
+            return -1;
+
+        *metadata = slot->metadata;
+        memcpy(payload, slot->payload, slot->metadata.payload_bytes);
+        state = atomic_load_explicit(&pcm_tap.state, memory_order_acquire);
+        if ((state >> 1) != generation) {
+            atomic_store_explicit(&pcm_tap.tail, tail + 1u, memory_order_release);
+            continue;
+        }
+        atomic_store_explicit(&pcm_tap.tail, tail + 1u, memory_order_release);
+        return 1;
+    }
+}
+
+uint32_t mpv_pcm_tap_dropped(void)
+{
+    return atomic_load_explicit(&pcm_tap.dropped, memory_order_relaxed);
+}
+
+int mpv_pcm_tap_diagnostic_state(void)
+{
+    return atomic_load_explicit(&pcm_tap.diagnostic_state,
+                                memory_order_acquire);
+}
+
+static bool pcm_tap_push(const mpv_pcm_tap_metadata *metadata,
+                         const void *payload, uint32_t generation)
+{
+    uint32_t head = atomic_load_explicit(&pcm_tap.head, memory_order_relaxed);
+    uint32_t tail = atomic_load_explicit(&pcm_tap.tail, memory_order_acquire);
+    if ((uint32_t)(head - tail) >= MPV_PCM_TAP_SLOT_COUNT) {
+        pcm_tap_drop();
+        return false;
+    }
+
+    struct pcm_tap_slot *slot =
+        &pcm_tap.slots[head & (MPV_PCM_TAP_SLOT_COUNT - 1u)];
+    slot->metadata = *metadata;
+    slot->metadata.sequence = head;
+    slot->generation = generation;
+    memcpy(slot->payload, payload, metadata->payload_bytes);
+    atomic_store_explicit(&pcm_tap.head, head + 1u, memory_order_release);
+    return true;
+}
+
+static void pcm_tap_capture(struct ao *ao, struct priv *p, int samples,
+                            int written_bytes,
+                            const struct ao_read_data_segment *segments,
+                            int segment_count, bool segment_overflow,
+                            uint32_t generation)
+{
+    mpv_pcm_tap_metadata metadata[AO_READ_DATA_MAX_PTS_SEGMENTS];
+    uint32_t offsets[AO_READ_DATA_MAX_PTS_SEGMENTS];
+    uint32_t accepted_frames, expected_offset = 0;
+    uint16_t sample_format;
+    int stride = ao->sstride;
+
+    uint32_t capture_state = atomic_load_explicit(&pcm_tap.state, memory_order_acquire);
+    if (!(capture_state & 1u) || (capture_state >> 1) != generation)
+        return;
+
+    if (p->format == AudioFormat.ENCODING_IEC61937 || ao->num_planes != 1 ||
+        stride <= 0 || samples <= 0 || written_bytes <= 0 ||
+        written_bytes > samples * stride || written_bytes % stride != 0 ||
+        segment_overflow || !segments || segment_count <= 0 ||
+        segment_count > AO_READ_DATA_MAX_PTS_SEGMENTS ||
+        ao->samplerate < 8000 || ao->channels.num <= 0 ||
+        ao->channels.num > 8) {
+        pcm_tap_drop();
+        return;
+    }
+
+    if (ao->format == AF_FORMAT_U8)
+        sample_format = 1;
+    else if (ao->format == AF_FORMAT_S16)
+        sample_format = 2;
+    else if (ao->format == AF_FORMAT_FLOAT)
+        sample_format = 3;
+    else {
+        pcm_tap_drop();
+        return;
+    }
+
+    accepted_frames = written_bytes / stride;
+    int mapped = 0;
+    for (int i = 0; i < segment_count && expected_offset < accepted_frames; i++) {
+        const struct ao_read_data_segment *segment = &segments[i];
+        if (segment->offset_samples != (int)expected_offset ||
+            segment->samples <= 0) {
+            pcm_tap_drop();
+            return;
+        }
+
+        uint32_t used_frames = MPMIN((uint32_t)segment->samples,
+                                     accepted_frames - expected_offset);
+        if (used_frames == 0)
+            break;
+
+        long double pts_ns = (long double)segment->pts * 1000000000.0L;
+        long double rate_scaled =
+            (long double)segment->effective_rate * 1000.0L;
+        if (!isfinite(segment->pts) || segment->pts < 0 ||
+            !isfinite(segment->effective_rate) ||
+            segment->effective_rate <= 0 || pts_ns > INT64_MAX ||
+            rate_scaled < 1 || rate_scaled > UINT32_MAX) {
+            pcm_tap_drop();
+            return;
+        }
+
+        uint64_t rate_num = (uint64_t)llroundl(rate_scaled);
+        uint64_t pts_value = (uint64_t)llroundl(pts_ns);
+        uint64_t bytes = (uint64_t)used_frames * (uint32_t)stride;
+        if (!rate_num || pts_value > INT64_MAX ||
+            bytes > MPV_PCM_TAP_MAX_PAYLOAD_BYTES || bytes > UINT32_MAX) {
+            pcm_tap_drop();
+            return;
+        }
+
+        metadata[mapped] = (mpv_pcm_tap_metadata) {
+            .pts_ns = (int64_t)pts_value,
+            .sample_rate = (uint32_t)ao->samplerate,
+            .effective_rate_num = (uint32_t)rate_num,
+            .effective_rate_den = 1000u,
+            .frames = used_frames,
+            .payload_bytes = (uint32_t)bytes,
+            .channels = (uint16_t)ao->channels.num,
+            .sample_format = sample_format,
+        };
+        offsets[mapped] = expected_offset * (uint32_t)stride;
+        mapped++;
+        expected_offset += (uint32_t)segment->samples;
+    }
+
+    if (mapped == 0) {
+        pcm_tap_drop();
+        return;
+    }
+
+    for (int i = 0; i < mapped; i++) {
+        if (!pcm_tap_push(&metadata[i],
+                          (const uint8_t *)p->chunk + offsets[i], generation))
+            continue;
+    }
+}
